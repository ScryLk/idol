# IDOL — variáveis de ambiente da API (validadas com Zod no boot; a API
# falha rápido se algo estiver ausente ou inválido).

# Ambiente: development | test | production
NODE_ENV=development

# Porta e host HTTP da API
PORT=3000
HOST=0.0.0.0

# Postgres 16 (docker compose local: usuário/senha/db "idol")
DATABASE_URL=postgresql://idol:idol@localhost:5432/idol

# Redis 7 (sessões, rate limiting, cache de leaderboard, timer de vidas)
REDIS_URL=redis://localhost:6379

# Segredo do JWT — mínimo 32 caracteres. Gere um novo para cada ambiente:
#   openssl rand -hex 32
JWT_SECRET=dev-secret-nao-use-em-producao-0123456789
